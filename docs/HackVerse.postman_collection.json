            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated John\",\n  \"bio\": \"Fullstack Developer\",\n  \"skills\": [\"React\", \"Node.js\"],\n  \"github\": \"https://github.com/example\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
