    {
      "name": "Hackathons",
      "item": [
        {
          "name": "List All Hackathons",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/hackathons?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["hackathons"] }
          }
        },
        {
          "name": "Create Hackathon",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Web3 Devfest 2026\",\n  \"description\": \"Build decentralized applications.\",\n  \"mode\": \"online\",\n  \"registrationDeadline\": \"2026-08-01T00:00:00.000Z\",\n  \"startDate\": \"2026-08-05T00:00:00.000Z\",\n  \"submissionDeadline\": \"2026-08-10T00:00:00.000Z\",\n  \"endDate\": \"2026-08-12T00:00:00.000Z\",\n  \"prizePool\": 25000,\n  \"maxTeamSize\": 4,\n  \"judgingCriteria\": [\n    { \"name\": \"Innovation\", \"description\": \"Novelty\", \"maxScore\": 50 },\n    { \"name\": \"Technical Execution\", \"description\": \"Code depth\", \"maxScore\": 50 }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/hackathons", "host": ["{{baseUrl}}"], "path": ["hackathons"] }
          }
        },
        {
          "name": "Get Hackathon by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/hackathons/{{hackathonId}}", "host": ["{{baseUrl}}"], "path": ["hackathons", "{{hackathonId}}"] }
          }
        },
        {
          "name": "Update Hackathon",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Web3 Devfest 2026 (Updated)\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/hackathons/{{hackathonId}}", "host": ["{{baseUrl}}"], "path": ["hackathons", "{{hackathonId}}"] }
          }
        },
        {
          "name": "Open Registration",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
            "url": { "raw": "{{baseUrl}}/hackathons/{{hackathonId}}/registration/open", "host": ["{{baseUrl}}"], "path": ["hackathons", "{{hackathonId}}", "registration", "open"] }
          }
        },
        {
          "name": "Close Registration",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizerToken}}" }],
            "url": { "raw": "{{baseUrl}}/hackathons/{{hackathonId}}/registration/close", "host": ["{{baseUrl}}"], "path": ["hackathons", "{{hackathonId}}", "registration", "close"] }
          }
        }
      ]
